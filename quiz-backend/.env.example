DATABASE_URL=postgresql+psycopg://quiz_user:your_password@localhost:5432/quiz_app

JWT_SECRET_KEY=<add the secret key>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

MEDIA_DIR=media
MAX_UPLOAD_SIZE_MB=10
MAX_VIDEO_UPLOAD_SIZE_MB=100

ENVIRONMENT=development
SQL_ECHO=false

# Keep the SQLAlchemy pool and synchronous worker capacity aligned.
DB_POOL_SIZE=60
DB_MAX_OVERFLOW=20
DB_WORKER_TOKENS=80
DB_POOL_TIMEOUT=10

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
