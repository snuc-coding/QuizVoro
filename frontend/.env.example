# Frontend Environment Variables

# Backend API base URL (FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Backend WebSocket base URL (e.g. ws://localhost:8000)
# If omitted or empty, it will be automatically derived from VITE_API_BASE_URL (http -> ws, https -> wss)
VITE_WS_BASE_URL=ws://localhost:8000
